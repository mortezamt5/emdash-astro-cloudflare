{
	"$schema": "https://emdashcms.com/seed.schema.json",
	"version": "1",
	"meta": {
		"name": "Starter",
		"description": "A minimal EmDash starter with posts and pages",
		"author": "EmDash"
	},
	"settings": {
		"title": "MORazon Website",
		"tagline": "Built with MORazon"
	},
	"blockTypes": [
		{
			"slug": "navigation_item",
			"label": "Navigation Item",
			"currentVersion": 1,
			"versions": [
				{
					"version": 1,
					"fields": [
						{
							"slug": "label",
							"label": "Label",
							"type": "string",
							"required": true
						},
						{
							"slug": "description",
							"label": "Description",
							"type": "text"
						},
						{
							"slug": "icon",
							"label": "Icon",
							"type": "image"
						},
						{ "slug": "feature_tag", "label": "Feature tag", "type": "string" },
						{ "slug": "feature_title", "label": "Feature title", "type": "string" },
						{ "slug": "feature_description", "label": "Feature description", "type": "text" },
						{ "slug": "feature_link_label", "label": "Feature link label", "type": "string" },
						{ "slug": "feature_href", "label": "Feature link URL", "type": "string" },
						{
							"slug": "link_type",
							"label": "Link type",
							"type": "select",
							"required": true,
							"defaultValue": "none",
							"validation": {
								"options": [
									"internal",
									"anchor",
									"external",
									"none"
								]
							}
						},
						{
							"slug": "href",
							"label": "Destination",
							"type": "string"
						},
						{
							"slug": "target",
							"label": "Target",
							"type": "select",
							"required": true,
							"defaultValue": "_self",
							"validation": {
								"options": [
									"_self",
									"_blank"
								]
							}
						},
						{
							"slug": "enabled",
							"label": "Enabled",
							"type": "boolean",
							"required": true,
							"defaultValue": true
						},
						{
							"slug": "children",
							"label": "Submenu items",
							"type": "repeater",
							"validation": {
								"maxItems": 40,
								"subFields": [
									{
										"slug": "label",
										"label": "Label",
										"type": "string",
										"required": true
									},
									{
										"slug": "description",
										"label": "Description",
										"type": "text"
									},
									{
										"slug": "icon",
										"label": "Icon",
										"type": "image"
									},
									{
										"slug": "link_type",
										"label": "Link type",
										"type": "select",
										"required": true,
										"options": [
											"internal",
											"anchor",
											"external",
											"none"
										]
									},
									{
										"slug": "href",
										"label": "Destination",
										"type": "string"
									},
									{
										"slug": "target",
										"label": "Target",
										"type": "select",
										"required": true,
										"options": [
											"_self",
											"_blank"
										]
									},
									{
										"slug": "enabled",
										"label": "Enabled",
										"type": "boolean",
										"required": true
									}
								]
							}
						}
					]
				}
			]
		}
	],
	"collections": [
		{
			"slug": "site_navigation",
			"label": "Navigation Menus",
			"labelSingular": "Navigation Menu",
			"routable": false,
			"group": "Site Configuration",
			"supports": [
				"drafts",
				"revisions"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true
				},
				{
					"slug": "menu_key",
					"label": "Menu key",
					"type": "string",
					"required": true,
					"unique": true
				},
				{
					"slug": "location",
					"label": "Location",
					"type": "select",
					"required": true,
					"validation": {
						"options": [
							"header",
							"footer",
							"other"
						]
					}
				},
				{
					"slug": "items",
					"label": "Items",
					"type": "blocks",
					"validation": {
						"allowedTypes": [
							"navigation_item"
						],
						"maxItems": 30
					}
				}
			]
		},
		{
			"slug": "posts",
			"label": "Posts",
			"labelSingular": "Post",
			"urlPattern": "/posts/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"scheduling",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "featured_image",
					"label": "Featured Image",
					"type": "image"
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				},
				{
					"slug": "excerpt",
					"label": "Excerpt",
					"type": "text"
				}
			]
		},
		{
			"slug": "pages",
			"label": "Pages",
			"labelSingular": "Page",
			"urlPattern": "/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"search",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "content",
					"label": "Content",
					"type": "portableText",
					"searchable": true
				}
			]
		}
	],
