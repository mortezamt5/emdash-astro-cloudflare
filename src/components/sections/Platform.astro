---
import { platformModules } from "../../data/platform";
---
<section class="sec" id="platform">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow">Platform</span>
      <h2>One platform for all your SIP needs</h2>
      <p class="lead">Streaming audio, video, analytics and integration from Edge to Cloud via Fog. Choose the power of choice in your eco-system.</p>
    </div>
    <div class="plat rv">
      <div class="plat-list" role="tablist" aria-label="Platform modules" id="platList">
        {platformModules.map((module, index) => (
          <button type="button" role="tab" id={"platform-tab-" + index} aria-controls={"platform-panel-" + index} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1}>
            <span class="pi"><svg class="ic" aria-hidden="true"><use href={"#" + module.ic} /></svg></span><span><b>{module.t}</b><small>{module.s}</small></span>
          </button>
        ))}
      </div>
      <div class="plat-panel" id="platPanel">
        {platformModules.map((module, index) => (
          <div class="plat-content" role="tabpanel" id={"platform-panel-" + index} aria-labelledby={"platform-tab-" + index} hidden={index !== 0}>
            <div class="plat-viz" set:html={module.v} />
            <div class="plat-txt fade-in"><span class="tag">{module.s}</span><h3>{module.t}</h3><p class="muted">{module.d}</p>
              <ul>{module.b.map((feature) => <li><svg class="ic" aria-hidden="true"><use href="#i-check" /></svg><span>{feature}</span></li>)}</ul>
              <a class="link-arrow" href={"https://sipazon.com/platform/" + ({mvm:"mvm",ha:"ha",rec:"siprec",video:"videoengine",vircom:"vircom",cc:"conncross"}[module.id])} target="_blank" rel="noopener noreferrer">Read more about {module.t} <svg class="ic" aria-hidden="true"><use href="#i-arrow" /></svg></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
