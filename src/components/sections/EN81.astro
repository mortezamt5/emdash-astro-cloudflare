<section class="sec" style="padding-bottom:clamp(40px,6vw,72px)">
  <div class="band" style="padding-block:clamp(56px,8vw,104px)">
    <span class="glow" style="right:-260px;bottom:-200px;background:radial-gradient(closest-side,var(--glow-2),transparent)"></span>
    <div class="wrap en81">
      <div class="sec-head rv" style="margin:0">
        <span class="eyebrow">Elevator · EN81</span>
        <h2>IP Intercom in compliance with EN81</h2>
        <p class="lead">By offering a purpose-built EN81 elevator critical communication solution, we contribute to creating a better society and strive to establish a safer and more trusted environment for passengers in every vertical transportation setting.</p>
        <div class="en81-feats">
          <div><svg class="ic"><use href="#i-speaker"/></svg>Voice communication per EN81</div>
          <div><svg class="ic"><use href="#i-camera"/></svg>Video surveillance</div>
          <div><svg class="ic"><use href="#i-users"/></svg>Call center</div>
          <div><svg class="ic"><use href="#i-monitor"/></svg>Remote monitoring, elevators &amp; escalators</div>
          <div><svg class="ic"><use href="#i-lock"/></svg>Access control</div>
          <div><svg class="ic"><use href="#i-cloud"/></svg>IoT cloud integration</div>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px">
          <a class="btn btn-primary" href="https://sipazon.com/solutions/elevator" target="_blank" rel="noopener noreferrer">Elevator solution <svg class="ic"><use href="#i-arrow"/></svg></a>
          <a class="btn btn-ghost" href="https://sipazon.com/platform/mvm" target="_blank" rel="noopener noreferrer">MvM Liftcom</a>
        </div>
      </div>
      <div class="shaft rv d1">
        <svg viewBox="0 0 440 500" role="img" aria-label="Bidirectional EN81 voice communication between car, car roof, pit, machine room, landing, lobby and control centre">
          <!-- shaft -->
          <rect x="70" y="30" width="120" height="440" rx="6" style="fill:var(--panel);stroke:var(--panel-line-2)"/>
          <line x1="85" y1="30" x2="85" y2="470" stroke-width="3" style="stroke:var(--panel-line)"/><line x1="175" y1="30" x2="175" y2="470" stroke-width="3" style="stroke:var(--panel-line)"/>
          <rect x="60" y="10" width="140" height="34" rx="6" style="fill:var(--panel-3);stroke:var(--panel-line-2)"/>
          <text x="130" y="31" text-anchor="middle" class="t2">MACHINE ROOM</text>
          <rect x="60" y="452" width="140" height="30" rx="6" style="fill:var(--panel-3);stroke:var(--panel-line-2)"/>
          <text x="130" y="471" text-anchor="middle" class="t2">PIT</text>
          <line x1="130" y1="44" x2="130" y2="120" stroke-width="1.2" style="stroke:var(--panel-dim)"/>
          <g class="car">
            <rect x="92" y="120" width="76" height="96" rx="6" style="fill:var(--hub-b);stroke:var(--p-primary)"/>
            <rect x="100" y="112" width="60" height="8" rx="2" style="fill:var(--panel-line-2)"/>
            <line x1="130" y1="126" x2="130" y2="210" style="stroke:var(--panel-line-2)"/>
            <circle cx="152" cy="150" r="5" style="fill:var(--p-signal)"><animate attributeName="opacity" values="1;.25;1" dur="1.2s" repeatCount="indefinite"/></circle>
            <text x="130" y="236" text-anchor="middle" class="t2" style="fill:var(--p-primary)">CAR · J-263-IP-1D</text>
          </g>
          <!-- landings -->
          <g style="fill:var(--panel-3);stroke:var(--panel-line-2)"><rect x="190" y="100" width="14" height="40"/><rect x="190" y="250" width="14" height="40"/><rect x="190" y="390" width="14" height="40"/></g>
          <!-- control centre -->
          <rect x="290" y="210" width="130" height="80" rx="12" style="fill:var(--panel-2);stroke:var(--hub-line)"/>
          <text x="355" y="240" text-anchor="middle" class="t1">Control centre</text>
          <text x="355" y="258" text-anchor="middle" class="t2">MvM Liftcom</text>
          <circle cx="355" cy="275" r="4" style="fill:var(--p-ok)"/>
          <!-- voice lines -->
          <path class="vl" d="M200 27 C 260 27, 300 160, 330 210"/>
          <path class="vl b" d="M170 160 C 230 160, 260 230, 290 245"/>
          <path class="vl" d="M204 270 L 290 262"/>
          <path class="vl b" d="M204 410 C 250 410, 290 320, 320 290"/>
          <path class="vl" d="M200 467 C 280 467, 340 360, 355 290"/>
          <!-- labels left -->
          <g class="t2"><text x="12" y="124">LANDING</text><text x="12" y="274">LOBBY</text><text x="12" y="414">LANDING</text></g>
          <line x1="60" y1="120" x2="70" y2="120" style="stroke:var(--panel-dim)"/><line x1="60" y1="270" x2="70" y2="270" style="stroke:var(--panel-dim)"/><line x1="60" y1="410" x2="70" y2="410" style="stroke:var(--panel-dim)"/>
          <text x="290" y="330" class="t2" style="fill:var(--p-signal)">⇄ BIDIRECTIONAL VOICE</text>
          <text x="290" y="348" class="t2">IP or wired networks</text>
        </svg>
        <div class="codes"><span>Car</span><span>Car roof</span><span>Pit</span><span>Machine room</span><span>Landing</span><span>Lobby</span><span>Control centre</span></div>
      </div>
    </div>
  </div>
</section>
